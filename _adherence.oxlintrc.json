{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/dashboard/**",
              "components/forms/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|ceremonial|mute)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'ceremonial' | 'mute'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|full|as|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, full, as, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|ceremonial)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'ceremonial'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Byline'] > JSXAttribute > JSXIdentifier[name!=/^(?:form|order|instance|entity|imprint|align|key|ref|className|style|children)$/]",
        "message": "<Byline> doesn't accept that prop. Declared props: form, order, instance, entity, imprint, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='Byline'] > JSXAttribute[name.name='form'] > Literal[value!=/^(?:Dr\\. Matt Booth)$/]",
        "message": "<Byline> form must be one of 'Dr. Matt Booth'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Byline'] > JSXAttribute[name.name='entity'] > Literal[value!=/^(?:house|labs|order)$/]",
        "message": "<Byline> entity must be one of 'house' | 'labs' | 'order'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Byline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Byline> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|padding|accentLeft|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, padding, accentLeft, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|raised|ceremonial|code)$/]",
        "message": "<Card> variant must be one of 'default' | 'raised' | 'ceremonial' | 'code'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EntityTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|state|on|icon|unavailable|onToggle|key|ref|className|style|children)$/]",
        "message": "<EntityTile> doesn't accept that prop. Declared props: name, state, on, icon, unavailable, onToggle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|prefix|value|onChange|placeholder|disabled|type|id|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, prefix, value, onChange, placeholder, disabled, type, id."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|active|icon|onSelect|key|ref|className|style|children)$/]",
        "message": "<ModeButton> doesn't accept that prop. Declared props: mode, active, icon, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='Motto'] > JSXAttribute > JSXIdentifier[name!=/^(?:gloss|align|framed|key|ref|className|style|children)$/]",
        "message": "<Motto> doesn't accept that prop. Declared props: gloss, align, framed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Motto'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Motto> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Seal'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|src|clearspace|alt|key|ref|className|style|children)$/]",
        "message": "<Seal> doesn't accept that prop. Declared props: size, src, clearspace, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|lede|rule|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: number, title, lede, rule."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|label|tone|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, disabled, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|ceremonial)$/]",
        "message": "<Switch> tone must be one of 'accent' | 'ceremonial'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onRemove|mono|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, onRemove, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tagline|entity|labs|color|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, tagline, entity, labs, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='entity'] > Literal[value!=/^(?:house|labs|order)$/]",
        "message": "<Wordmark> entity must be one of 'house' | 'labs' | 'order'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
